{
  "name": "@homelink/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/local.ts",
    "start": "node dist/local.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "latency": "vitest run tests/latency.test.ts --reporter=verbose"
  },
  "dependencies": {
    "better-sqlite3": "11.5.0",
    "cors": "2.8.5",
    "express": "4.21.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.145",
    "@types/better-sqlite3": "7.6.11",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.1.4",
    "ajv": "8.17.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
