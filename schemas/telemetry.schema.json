{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelink.local/schemas/telemetry.schema.json",
  "title": "HomeLink Telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "thing_id",
    "seq",
    "ts_ms",
    "fw_version",
    "state",
    "motor_current_a",
    "motor_rpm",
    "suction_pa",
    "battery_pct",
    "bin_pct",
    "runtime_s",
    "error_code"
  ],
  "properties": {
    "thing_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "seq": { "type": "integer", "minimum": 0 },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "fw_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "state": { "enum": ["IDLE", "RUNNING", "DOCKED", "ERROR", "OTA"] },
    "motor_current_a": { "type": "number", "minimum": 0.0, "maximum": 20.0 },
    "motor_rpm": { "type": "number", "minimum": 0.0, "maximum": 20000.0 },
    "suction_pa": { "type": "number", "minimum": 0.0, "maximum": 5000.0 },
    "battery_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
    "bin_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
    "runtime_s": { "type": "number", "minimum": 0.0 },
    "error_code": {
      "enum": [
        "NONE",
        "BRUSH_JAM",
        "FILTER_CLOG",
        "WHEEL_STALL",
        "LOW_BATTERY",
        "OTA_CHECKSUM",
        "SENSOR_FAULT"
      ]
    }
  }
}
